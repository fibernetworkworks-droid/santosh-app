__pycache__/
*.pyc
desktop/build/
desktop/dist/
*.spec
# the canonical Windows exe build recipe must be committed (desktop/README.md "Build SantoshDesktop.exe")
!desktop/santosh_desktop.spec

# v0.130 font cache filled at runtime (downloaded open-licence fonts)
server/data/app_fonts/
server/data/hoola_server.key
server/data/logos/
server/data/gyaan/
server/data/quality/
.venv-test/
server/.venv-test/

# Flutter local build artifacts (CI regenerates the Android project with `flutter create` + `pub get`;
# none of these has ever been tracked - they only appear when someone runs Flutter in a sandbox)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
pubspec.lock
