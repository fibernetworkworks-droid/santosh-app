<!-- v0.461 the owner's logo as the notification / quick-tile icon: the spark, its core and the two orbits.
     Android strips every colour from a status-bar icon and keeps only the shape, so this is the logo drawn as a
     flat white silhouette on transparent - a glow cannot survive here, the form can. Kept at 24dp with strokes no
     thinner than 1.4dp so it is still readable in the status bar. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp" android:viewportWidth="24" android:viewportHeight="24">
    <!-- the outer orbit, over the top -->
    <path android:fillColor="#00000000" android:strokeColor="#FFFFFFFF" android:strokeWidth="1.5"
        android:strokeLineCap="round" android:pathData="M4.81,7.85 A8.3,8.3 0 0 1 19.19,7.85" />
    <!-- the inner orbit, under the bottom -->
    <path android:fillColor="#00000000" android:strokeColor="#FFFFFFFF" android:strokeWidth="1.5"
        android:strokeLineCap="round" android:pathData="M17.72,15.3 A6.6,6.6 0 0 1 6.28,15.3" />
    <!-- the spark through the middle -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M20.1,3.9 L13.1,13.1 L3.9,20.1 L10.9,10.9 Z" />
    <!-- the core -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M12,9.1 A2.9,2.9 0 1 0 12.01,9.1 Z" />
</vector>
