<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- v0.55 reel scroll analysis: time spent in reel apps (the owner turns on Usage Access in Settings) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- v0.97 fingerprint-signed approvals (BiometricPrompt; normal permissions, no prompt) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- background mode: a live link to Santosh while the app is closed -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Santosh's own alarms and timers when the app is closed -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- saving calendar events directly -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Google Maps in Santosh: "near me", directions, cab pickup (only while the app is open) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Ghar (home devices): AC via the IR blaster, TV as a Bluetooth remote + DIAL on Wi-Fi, music volume -->
    <uses-permission android:name="android.permission.TRANSMIT_IR" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <!-- Hoola Bluetooth: find nearby speakers, earbuds and TVs to pair (never used for location) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- v0.62 in-app update of the GitHub APK (removed by patch_android.py for a Play Store build: HOOLA_CHANNEL=play) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.consumerir" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- Android 11+ only lets the app see these apps if it declares what it wants to do -->
    <queries>
        <intent><action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" /></intent>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <intent><action android:name="android.intent.action.SET_ALARM" /></intent>
        <intent><action android:name="android.intent.action.SET_TIMER" /></intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- v0.125 YouTube play: the YouTube app opens vnd.youtube: links -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="vnd.youtube" />
        </intent>
        <package android:name="com.google.android.youtube" />
        <!-- Santosh Bazar: UPI payments and the UPI / ride apps it can open -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
        <package android:name="com.dreamplug.androidapp" />
        <package android:name="com.freecharge.android" />
        <package android:name="com.google.android.apps.nbu.paisa.user" />
        <package android:name="com.jio.jiofinance" />
        <package android:name="com.mobikwik_new" />
        <package android:name="com.myairtelapp" />
        <package android:name="com.naviapp" />
        <package android:name="com.olacabs.customer" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.phonepe.app" />
        <package android:name="com.popclub.android" />
        <package android:name="com.rapido.passenger" />
        <package android:name="com.ubercab" />
        <package android:name="in.amazon.mShop.android.shopping" />
        <package android:name="in.gokiwi.kiwitpap" />
        <package android:name="in.juspay.jatrisaathi" />
        <package android:name="in.juspay.nammayatri" />
        <package android:name="in.org.npci.upiapp" />
        <package android:name="money.fold.android" />
        <package android:name="money.super.payments" />
        <package android:name="net.one97.paytm" />
        <package android:name="sinet.startup.inDriver" />
    </queries>

    <!-- usesCleartextTraffic lets you test against http://your-ip:8077; use https in production -->
    <application
        android:label="Hoola"
        android:name=".HoolaApplication"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="io.flutter.embedding.android.NormalTheme" android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- v0.49 Share to Hoola: photos, PDFs, videos, any file or text from any app -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- Long-press home / assistant gesture can open Santosh -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Sign in with Google returns here: santosh://auth?session=... -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="santosh" android:host="auth" />
            </intent-filter>
            <!-- Hoola QR / invite links: santosh://connect?c=CODE (and hoola://connect) -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="santosh" android:host="connect" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hoola" android:host="connect" />
            </intent-filter>
            <!-- Linking Swiggy / Zomato etc. returns here: santosh://bazar?linked=1 -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="santosh" android:host="bazar" />
            </intent-filter>
            <!-- Connecting Gmail / Outlook returns here: santosh://mail?ok=1 -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="santosh" android:host="mail" />
            </intent-filter>
            <!-- Connecting Google Calendar returns here: santosh://calendar?ok=1 -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="santosh" android:host="calendar" />
            </intent-filter>
            <!-- Connecting Google Sheets / Drive / Forms returns here -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="santosh" android:host="sheets" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="santosh" android:host="drive" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="santosh" android:host="forms" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="santosh" android:host="slides" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="santosh" android:host="photos" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="santosh" android:host="youtube" />
            </intent-filter>
        </activity>
        <meta-data android:name="flutterEmbedding" android:value="2" />
        <!-- v0.62 which build this is: github (updates itself, owner taps Install) | play (Play Store updates it) -->
        <meta-data android:name="hoola.channel" android:value="github" />

        <!-- v0.62 Hoola as the phone's digital assistant (owner picks it in Settings > Default apps). Screen text /
             screenshot only arrive when she long-presses home and has allowed it for the assistant. -->
        <service
            android:name=".HoolaAssistService"
            android:exported="true"
            android:label="Hoola"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data android:name="android.voice_interaction" android:resource="@xml/hoola_interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>
        <service
            android:name=".HoolaAssistSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <!-- passes voice typing on to the phone's own recogniser (Android makes the assistant the voice-input app too) -->
        <service
            android:name=".HoolaRecognition"
            android:exported="true"
            android:label="Hoola (phone ki awaaz pehchaan)">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.speech" android:resource="@xml/hoola_recognition" />
        </service>
        <!-- v0.62 the small chat inside the floating bubble (Android Bubbles API) and the widget's "Likho" -->
        <activity
            android:name=".BubbleActivity"
            android:exported="false"
            android:allowEmbedded="true"
            android:documentLaunchMode="always"
            android:resizeableActivity="true"
            android:label="Hoola"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        <!-- v0.62 home-screen widget -->
        <receiver android:name=".HoolaWidget" android:exported="false" android:label="Hoola">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/hoola_widget_info" />
        </receiver>

        <!-- "Hey Santosh" wake word (on-device) -->
        <service
            android:name=".WakeService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- Live voice call with Santosh: keeps mic + audio running when the screen locks -->
        <service
            android:name=".CallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- Push messages from Santosh (Firebase Cloud Messaging) when the app is closed or the phone is locked -->
        <service
            android:name=".SantoshPush"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data android:name="firebase_analytics_collection_deactivated" android:value="true" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <!-- v0.84 Galla: reads ONLY 'money received' alerts of the payment apps the owner picked, after she gives
             notification access herself in Android settings (off by default; Chai screen > Galla). -->
        <service
            android:name=".HoolaPayListener"
            android:exported="true"
            android:label="Hoola Galla (UPI payment alerts)"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Quick-settings tile -->
        <service
            android:name=".SantoshTile"
            android:exported="true"
            android:icon="@drawable/ic_stat_santosh"
            android:label="Hoola"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Santosh background mode -->
        <service
            android:name=".SantoshService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />
        <!-- Ghar: keeps the "Santosh Remote" Bluetooth TV remote registered -->
        <service
            android:name=".RemoteService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <activity
            android:name=".AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="com.newtika.santosh.alarm"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <receiver android:name=".AlarmReceiver" android:exported="false" />
        <receiver android:name=".ScrollAlarmReceiver" android:exported="false" />
        <receiver android:name=".CallHangupReceiver" android:exported="false" />
        <!-- v0.63 share Hoola Motion videos with other apps (content:// from the app cache only) -->
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.hoolafiles"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/hoola_paths" />
        </provider>
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- scheduled reminder notifications (flutter_local_notifications) -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
