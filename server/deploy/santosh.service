# /etc/systemd/system/santosh.service
# Run ONE process only: the campaign worker lives inside the app, so do not add --workers.
[Unit]
Description=Santosh core (AI coworker backend)
After=network.target

[Service]
User=santosh
WorkingDirectory=/opt/santosh-core
EnvironmentFile=/opt/santosh-core/.env
ExecStart=/opt/santosh-core/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8077 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
