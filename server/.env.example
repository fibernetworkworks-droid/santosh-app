# Copy to .env and fill in. Never commit the real .env.

# --- Santosh's brain (Claude API key from console.anthropic.com) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Chat brain switch. auto = OmniRoute if OMNIROUTE_URL is set, else GLM if GLM_API_KEY is set, else Claude.
# Claude stays as the fallback either way. OmniRoute setup: deploy/omniroute/README.md
CHAT_LLM=auto
OMNIROUTE_URL=
OMNIROUTE_KEY=
OMNIROUTE_MODEL=santosh
# Low-cost chat brain direct (any OpenAI-compatible API)
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MODEL=glm-4.7
GLM_THINKING=disabled

# --- Protect the API (the app sends "Authorization: Bearer <API_KEY>") ---
API_KEY=change-this-to-a-long-random-string

# --- Database (SQLite is fine to start; use Postgres for many users) ---
DATABASE_URL=sqlite:///./santosh.db
# DATABASE_URL=postgresql+psycopg://santosh:password@localhost:5432/santosh

# --- WhatsApp: keep true until Meta is set up. true = nothing is really sent ---
WA_DRY_RUN=true
WA_TOKEN=
WA_WABA_ID=
WA_PHONE_NUMBER_ID=
WA_GRAPH_VERSION=v21.0
WA_VERIFY_TOKEN=pick-any-secret-word
WA_APP_SECRET=

# --- Limits: set MAX_DAILY_SENDS to your number's Meta messaging limit ---
MAX_DAILY_SENDS=250
SEND_RATE_PER_SEC=8
TEMPLATE_POLL_SECONDS=60

# --- Test mode only ---
DRY_RUN_APPROVAL_SECONDS=20

# Realtime voice for the Baat tab (human-like male voice, hears your tone). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-3.8-live
# VOICE_DEFAULT=Puck
# VOICE_SILENCE_MS=1100
# VOICE_AFFECTIVE_DIALOG=false   # turn on when Google supports it for your model
# VOICE_PROACTIVE_AUDIO=false

# Email (optional): Santosh reads your inbox and sends replies you approve.
# Use an APP PASSWORD, never your normal password. Gmail: myaccount.google.com/apppasswords
EMAIL_ADDRESS=
EMAIL_PASSWORD=
# Hosts auto-detect for gmail/outlook/zoho/yahoo/rediff. For a custom domain, set these:
# EMAIL_IMAP_HOST=imap.yourhost.com
# EMAIL_SMTP_HOST=smtp.yourhost.com
# EMAIL_SMTP_PORT=587
# EMAIL_SENDER_NAME=Meghana (FNW)
# Each person can also connect their own mailbox in the app (Profile > Email):
#  - Gmail: uses GOOGLE_OAUTH_CLIENT_ID/SECRET below (enable the Gmail API in the same Google Cloud project)
#  - Outlook / Hotmail / Microsoft 365: register an app in Microsoft Entra (portal.azure.com > App registrations),
#    redirect URI = <PUBLIC_BASE_URL>/auth/microsoft/callback, API permissions Mail.ReadWrite + Mail.Send + User.Read
# MS_OAUTH_CLIENT_ID=
# MS_OAUTH_CLIENT_SECRET=
# YouTube: a YouTube Data API v3 key (Google Cloud > APIs > Credentials > API key, restrict it to YouTube Data API)
# YOUTUBE_API_KEY=
# App Jaanch (check APK / EXE before installing) with REA, static only. Install: bash deploy/install_rea.sh
# REA_BIN=/home/fnw/apps/rea/node_modules/.bin/rea
# REA_JADX_JAR=/home/fnw/apps/rea/jadx-headless-mcp-0.7.1-all.jar
# APPCHECK_MAX_MB=400
# MAIL_BULK_PER_MINUTE=12
# MAIL_BULK_DAILY_CAP=300

# Google Drive/Sheets/Docs (optional): a service-account JSON key on the server.
# Create a service account in Google Cloud, enable Drive+Sheets+Docs APIs, download the key,
# then share a Drive folder with the service account's email as Editor.
# GOOGLE_SA_FILE=/home/fnw/apps/santosh-core/santosh-sa.json
# GOOGLE_DRIVE_FOLDER_ID=the-folder-id-from-its-url

# Santosh Browser (server/browser_worker): browser-use + headless Chromium in its own pm2 process
BROWSER_WORKER_URL=
BROWSER_WORKER_KEY=
BROWSER_LLM=auto
