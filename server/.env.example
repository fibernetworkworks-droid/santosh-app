# Copy to .env and fill in. Never commit the real .env.

# --- Santosh's brain (Claude API key from console.anthropic.com) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Chat brain switch. auto = OmniRoute if OMNIROUTE_URL is set, else GLM if GLM_API_KEY is set, else Claude.
# Claude stays as the fallback either way. OmniRoute setup: deploy/omniroute/README.md
CHAT_LLM=auto
OMNIROUTE_URL=
OMNIROUTE_KEY=
OMNIROUTE_MODEL=santosh
# Low-cost chat brain direct (any OpenAI-compatible API)
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MODEL=glm-4.7
GLM_THINKING=disabled

# --- Protect the API (the app sends "Authorization: Bearer <API_KEY>") ---
API_KEY=change-this-to-a-long-random-string

# --- Database (SQLite is fine to start; use Postgres for many users) ---
DATABASE_URL=sqlite:///./santosh.db
# DATABASE_URL=postgresql+psycopg://santosh:password@localhost:5432/santosh

# --- WhatsApp: keep true until Meta is set up. true = nothing is really sent ---
WA_DRY_RUN=true
WA_TOKEN=
WA_WABA_ID=
WA_PHONE_NUMBER_ID=
WA_GRAPH_VERSION=v21.0
WA_VERIFY_TOKEN=pick-any-secret-word
WA_APP_SECRET=

# --- Limits: set MAX_DAILY_SENDS to your number's Meta messaging limit ---
MAX_DAILY_SENDS=250
SEND_RATE_PER_SEC=8
TEMPLATE_POLL_SECONDS=60

# --- Test mode only ---
DRY_RUN_APPROVAL_SECONDS=20

# Realtime voice for the Baat tab (human-like male voice, hears your tone). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-3.8-live
# VOICE_DEFAULT=Puck
# VOICE_SILENCE_MS=700          # pause that ends your turn (500-800 feels human; raise if he cuts you off)
# VOICE_END_SENSITIVITY=        # blank = Gemini default | low | high
# VOICE_PREFIX_PADDING_MS=300
# VOICE_START_SENSITIVITY=low   # low = TV / far voices don't cut him off | high | blank = Gemini default
# VOICE_RESUME_AFTER_NOISE_S=1.5  # cut off by noise and nobody spoke: he finishes his point (0 = off)
# VOICE_TOOL_ACK=true
# Awaaz Pehchaan (who is talking): run deploy/setup_voiceid.sh once; these are the defaults
# VOICEID_MODELS_DIR=./data/voiceid_models
# VOICEID_MATCH=0.30            # similarity needed to recognise someone
# VOICEID_MARGIN=0.06           # and this much ahead of the next closest person           # quick "ek second" in his own voice while a tool runs

# Email (optional): Santosh reads your inbox and sends replies you approve.
# Use an APP PASSWORD, never your normal password. Gmail: myaccount.google.com/apppasswords
EMAIL_ADDRESS=
EMAIL_PASSWORD=
# Hosts auto-detect for gmail/outlook/zoho/yahoo/rediff. For a custom domain, set these:
# EMAIL_IMAP_HOST=imap.yourhost.com
# EMAIL_SMTP_HOST=smtp.yourhost.com
# EMAIL_SMTP_PORT=587
# EMAIL_SENDER_NAME=Meghana (FNW)
# Each person can also connect their own mailbox in the app (Profile > Email):
#  - Gmail: uses GOOGLE_OAUTH_CLIENT_ID/SECRET below (enable the Gmail API in the same Google Cloud project)
#  - Outlook / Hotmail / Microsoft 365: register an app in Microsoft Entra (portal.azure.com > App registrations),
#    redirect URI = <PUBLIC_BASE_URL>/auth/microsoft/callback, API permissions Mail.ReadWrite + Mail.Send + User.Read
# MS_OAUTH_CLIENT_ID=
# MS_OAUTH_CLIENT_SECRET=
# YouTube: a YouTube Data API v3 key (Google Cloud > APIs > Credentials > API key, restrict it to YouTube Data API)
# YOUTUBE_API_KEY=
# App Jaanch (check APK / EXE before installing) with REA, static only. Install: bash deploy/install_rea.sh
# REA_BIN=/home/fnw/apps/rea/node_modules/.bin/rea
# REA_JADX_JAR=/home/fnw/apps/rea/jadx-headless-mcp-0.7.1-all.jar
# APPCHECK_MAX_MB=400
# Hoola Network federation (avatars on other Hoola servers). Domain defaults to the host of PUBLIC_BASE_URL.
# HOOLA_DOMAIN=hoola.ainewtika.com
# HOOLA_FEDERATION=true
# HOOLA_BLOCKED_SERVERS=
# MAIL_BULK_PER_MINUTE=12
# MAIL_BULK_DAILY_CAP=300

# Google Drive/Sheets/Docs (optional): a service-account JSON key on the server.
# Create a service account in Google Cloud, enable Drive+Sheets+Docs APIs, download the key,
# then share a Drive folder with the service account's email as Editor.
# GOOGLE_SA_FILE=/home/fnw/apps/santosh-core/santosh-sa.json
# GOOGLE_DRIVE_FOLDER_ID=the-folder-id-from-its-url

# Santosh Browser (server/browser_worker): browser-use + headless Chromium in its own pm2 process
BROWSER_WORKER_URL=
BROWSER_WORKER_KEY=
BROWSER_LLM=auto

# v0.134 Gyaan (Hoola's own RAG). Works with no keys (offline / FastEmbed). Optional better search:
# GYAAN_EMBED=auto            # auto | hash | fastembed | voyage | gemini
# VOYAGE_API_KEY=             # voyage-4-lite embeddings + rerank-2.5-lite (put the real key only in the VPS .env)
# GYAAN_RERANK=true
# GYAAN_MAIL_DAYS=60

# Websites Hoola builds and hosts (v0.122+; full steps in deploy/sites_hosting.md). Empty = feature off.
# SITES_BASE_DOMAIN=hoolasites.in          # free addresses <name>.<this> (wildcard DNS proxied to this server)
# SITES_ORIGIN=origin.hoolasites.in        # Cloudflare for SaaS fallback origin (her own domains)
# SITES_ORIGIN_IP=                          # this server's public IP (her own Cloudflare zone proxies to it)
# SITES_DIRECT_IP=                          # v0.280 direct mode like Lovable: her domain A @ + A www -> this IP (DNS only) + _hoola TXT
# SITES_CF_TOKEN=                           # Newtika's Cloudflare token for the sites zone (custom hostnames)
# SITES_CF_ZONE_ID=
# SITE_WORKERS=2                            # v0.223 websites built at the same time
# SITE_AI_PHOTOS=6                          # v0.291 pictures a site gets before its looks (her photos first, AI fills the gap; 0 = off)
# PEXELS_API_KEY=                           # v0.291 optional licensed stock photos (pexels.com/api) when the image models fail
# SITE_LOOK_SECTIONS=3                      # v0.291 sections each of the 3 looks shows (hero + the next ones)
# SITE_CRITIQUE=all                         # v0.291 Opus reviews every page's screenshots (all | home | off), SITE_CRITIQUE_PAGES=6
# SITES_UPTIME_KEY=                         # v0.224 outside uptime check (GitHub secret of the same name), 16+ chars
# SITES_BACKUP_BUCKET=                      # v0.224 daily backup of the website files (S3 / R2 / B2 / Spaces)
# SITES_BACKUP_ENDPOINT=                    #   e.g. https://<account>.r2.cloudflarestorage.com (empty = AWS S3)
# SITES_BACKUP_REGION=auto
# SITES_BACKUP_KEY_ID=
# SITES_BACKUP_SECRET=
# SITES_BACKUP_KEEP_DAYS=14
